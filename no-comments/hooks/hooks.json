{
  "description": "Blocks comments in code on Edit/Write/MultiEdit/NotebookEdit; snapshots source files around every shell command and rolls the command's file changes back if they add comments.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-comments.py\"",
            "statusMessage": "No-comments guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-comments.py\"",
            "statusMessage": "No-comments guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-comments.py\"",
            "statusMessage": "No-comments guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
